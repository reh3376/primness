{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "measurement-event/1",
  "title": "Measurement event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ts_ms",
    "run_id",
    "source",
    "kind",
    "scale",
    "instance",
    "b",
    "evaluated",
    "smooth",
    "elapsed_ms",
    "rate_per_s",
    "residues"
  ],
  "properties": {
    "schema_version": { "const": "measurement-event/1" },
    "ts_ms": { "type": "integer", "minimum": 0 },
    "run_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "source": { "type": "string", "minLength": 1, "maxLength": 80 },
    "kind": { "enum": ["start", "sample", "finish"] },
    "scale": { "enum": ["toy", "scaled-down", "full"] },
    "instance": { "type": "string", "maxLength": 300 },
    "b": { "type": "integer", "minimum": 0 },
    "evaluated": { "type": "integer", "minimum": 0 },
    "smooth": { "type": "integer", "minimum": 0 },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "rate_per_s": { "type": "number", "minimum": 0 },
    "residues": { "type": "string", "maxLength": 64, "pattern": "^[01]*$" }
  }
}
