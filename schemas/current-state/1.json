{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "current-state/1",
  "title": "Current-state contract",
  "description": "Requirements for version current-state/1 of the roadmap Current State gate. Each property const is the requirement this version enforces. Enums are the closed options. The checker selects the version named by the head document's metadata line (version_metadata_label). Every current-state contract in one commit must agree on version_metadata_label, roadmap_path, metadata_line_prefix, and metadata_label_suffix, because that pointer is read before a version is chosen. A later version is a new file. This file stays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "version_metadata_label",
    "roadmap_path",
    "history_path",
    "companion_paths",
    "section_heading",
    "section_ends",
    "stamp_prefix",
    "stamp_suffix",
    "history_heading_prefix",
    "keep_previous_history_heading",
    "metadata_line_prefix",
    "metadata_label_suffix",
    "roadmap_labels_must_change",
    "roadmap_labels_required_on_head",
    "history_labels_must_change",
    "history_labels_required_on_head",
    "require_section_changed",
    "require_stamp_changed"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "const": "current-state/1"
    },
    "role": {
      "description": "Closed list of contract roles. This version has one.",
      "type": "string",
      "enum": ["current-state-contract"],
      "const": "current-state-contract"
    },
    "version_metadata_label": {
      "description": "Roadmap metadata label whose value is this schema $id.",
      "type": "string",
      "enum": ["Schema"],
      "const": "Schema"
    },
    "roadmap_path": {
      "type": "string",
      "minLength": 1,
      "const": "primness_roadmap.md"
    },
    "history_path": {
      "type": "string",
      "minLength": 1,
      "const": "context_convo_notes/current_state_history.md"
    },
    "companion_paths": {
      "description": "Files that must differ between base and head in the same change.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 },
      "const": ["README.md"]
    },
    "section_heading": {
      "type": "string",
      "minLength": 1,
      "const": "## Current State"
    },
    "section_ends": {
      "description": "The section stops at the first line that matches any of these, in order. match is a closed list.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["match", "text"],
        "properties": {
          "match": { "enum": ["prefix", "exact"] },
          "text": { "type": "string", "minLength": 1 }
        }
      },
      "const": [
        { "match": "prefix", "text": "## " },
        { "match": "exact", "text": "---" }
      ]
    },
    "stamp_prefix": {
      "type": "string",
      "minLength": 1,
      "const": "As of "
    },
    "stamp_suffix": {
      "type": "string",
      "minLength": 1,
      "const": ":"
    },
    "history_heading_prefix": {
      "type": "string",
      "minLength": 1,
      "const": "### "
    },
    "keep_previous_history_heading": {
      "type": "boolean",
      "const": true
    },
    "metadata_line_prefix": {
      "type": "string",
      "minLength": 1,
      "const": "- **"
    },
    "metadata_label_suffix": {
      "type": "string",
      "minLength": 1,
      "const": "**: "
    },
    "roadmap_labels_must_change": {
      "description": "Metadata labels that must be present on base and head and must differ.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Created",
          "Last Modified",
          "Version",
          "Tags",
          "Related Files",
          "Repository",
          "Schema"
        ]
      },
      "const": ["Last Modified"]
    },
    "roadmap_labels_required_on_head": {
      "description": "Metadata labels the head document must carry. Base may omit a label that is not also in roadmap_labels_must_change.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Created",
          "Last Modified",
          "Version",
          "Tags",
          "Related Files",
          "Repository",
          "Schema"
        ]
      },
      "const": ["Last Modified", "Schema"]
    },
    "history_labels_must_change": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Created",
          "Last Modified",
          "Version",
          "Tags",
          "Related Files",
          "Repository",
          "Schema"
        ]
      },
      "const": ["Last Modified"]
    },
    "history_labels_required_on_head": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Created",
          "Last Modified",
          "Version",
          "Tags",
          "Related Files",
          "Repository",
          "Schema"
        ]
      },
      "const": ["Last Modified"]
    },
    "require_section_changed": {
      "type": "boolean",
      "const": true
    },
    "require_stamp_changed": {
      "type": "boolean",
      "const": true
    }
  }
}
