{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d1-measurement/1",
  "title": "D1 smoothness measurement",
  "description": "One run of the independent smoothness count on an instrument polynomial over a rectangular (a, b) region with gcd(a, b) = 1, compared with the Dickman-de Bruijn prediction, the mean over the region of rho(ln|F(a, b)| / ln B). observed_stderr is the binomial standard error sqrt(p(1-p)/n) of the observed density. Version 1 applies no adjustment: alpha_applied is always false. scale says how far the run is from the 40-80 digit protocol. The nested polynomial is an instrument-polynomial/1 record and is validated against that schema separately. hardware, when present, is the finish summary of the hardware-sample/1 trace recorded beside the run; the trace file holds the per-interval samples.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "ts_ms",
    "elapsed_ms",
    "instance",
    "n",
    "n_digits",
    "polynomial",
    "region",
    "scale",
    "bounds",
    "evaluated",
    "skipped_zero",
    "dickman",
    "alpha_applied",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "d1-measurement/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "ts_ms": {
      "type": "integer",
      "minimum": 0
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "instance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "n": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "n_digits": {
      "type": "integer",
      "minimum": 1
    },
    "polynomial": {
      "type": "object",
      "required": [
        "schema_version"
      ],
      "properties": {
        "schema_version": {
          "const": "instrument-polynomial/1"
        }
      }
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "a_min",
        "a_max",
        "b_min",
        "b_max",
        "coprime_only",
        "skip_zero"
      ],
      "properties": {
        "a_min": {
          "type": "integer"
        },
        "a_max": {
          "type": "integer"
        },
        "b_min": {
          "type": "integer",
          "minimum": 1
        },
        "b_max": {
          "type": "integer",
          "minimum": 1
        },
        "coprime_only": {
          "const": true
        },
        "skip_zero": {
          "const": true
        }
      }
    },
    "scale": {
      "enum": [
        "scaled-down",
        "full"
      ]
    },
    "bounds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 2
      }
    },
    "evaluated": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_zero": {
      "type": "integer",
      "minimum": 0
    },
    "threads": {
      "type": "integer",
      "minimum": 1
    },
    "dickman": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "steps_per_unit",
        "u_max"
      ],
      "properties": {
        "method": {
          "enum": [
            "simpson-grid"
          ]
        },
        "steps_per_unit": {
          "type": "integer",
          "minimum": 2
        },
        "u_max": {
          "type": "integer",
          "minimum": 2
        }
      }
    },
    "alpha_applied": {
      "const": false
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "b",
          "algebraic",
          "rational",
          "both_smooth"
        ],
        "properties": {
          "b": {
            "type": "integer",
            "minimum": 2
          },
          "algebraic": {
            "$ref": "#/$defs/side"
          },
          "rational": {
            "$ref": "#/$defs/side"
          },
          "both_smooth": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "samples_file",
        "summary"
      ],
      "properties": {
        "schema_version": {
          "const": "hardware-sample/1"
        },
        "samples_file": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "object"
        }
      }
    }
  },
  "$defs": {
    "side": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "smooth",
        "observed",
        "observed_stderr",
        "predicted",
        "gap",
        "mean_u"
      ],
      "properties": {
        "smooth": {
          "type": "integer",
          "minimum": 0
        },
        "observed": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "predicted": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gap": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "mean_u": {
          "type": "number",
          "minimum": 0
        },
        "observed_stderr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
