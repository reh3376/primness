# Schema for the gitignored .env. Copy to .env and fill the secret locally.
# Do not put real tokens in this file.

# Measurement bench (loopback only)
PRIMNESS_DASHBOARD_HOST=127.0.0.1
PRIMNESS_DASHBOARD_PORT=9477
PRIMNESS_METRICS_DIR=data/metrics
PRIMNESS_METRICS_URL=http://127.0.0.1:9477/api/ingest

# GitHub. Leave the token empty here. The local .env holds the gh credential.
GITHUB_HOST=github.com
GITHUB_USER=
GITHUB_REPO=https://github.com/reh3376/primness.git
GITHUB_TOKEN=

# Ollama. No login.
OLLAMA_HOST=127.0.0.1
OLLAMA_PORT=11434

# Docker Desktop engine. No registry password is stored for the local socket.
DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_REGISTRY_USER=

# Chrome control is not connected. No Chrome login is stored.
CHROME_CONTROL=unavailable

# Primness Postgres. Set the password only in the gitignored .env.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5455
POSTGRES_USER=primness
POSTGRES_PASSWORD=
POSTGRES_DB=primness
PRIMNESS_DATABASE_URL=
